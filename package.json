{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.ts --host 0.0.0.0 --port 5173",
        "dev:laravel": "vite --config vite.config.js",
        "serve:laravel": "php -S 127.0.0.1:8000 server.php",
        "build": "vite build",
        "lint": "tsc --noEmit",
        "preview": "vite preview --host 0.0.0.0 --port 3000",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:ci": "playwright test --reporter=github,html"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^4.3.4",
        "alpinejs": "^3.14.9",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "lucide-react": "^1.38.0",
        "motion": "^13.1.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0"
    }
